generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  emailVerified         DateTime?
  image                 String?
  isActive              Boolean                @default(true)
  lastLogin             DateTime?
  role                  UserRole               @default(STUDENT)
  accounts              Account[]
  applications          Application[]
  documents             Document[]
  missions              Mission[]
  notifications         Notification[]
  otpVerifications      OTPVerification[]
  opportunityMatches    OpportunityMatch[]
  passwordResetSessions PasswordResetSession[]
  profile               Profile?
  resumeAnalyses        ResumeAnalysis[]
  roadmaps              Roadmap[]
  savedOpportunities    SavedOpportunity[]
  sessions              Session[]
  xp                    UserXP?
  activityDays          UserActivityDay[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OTPVerification {
  id        String     @id @default(uuid())
  email     String
  otpHash   String
  purpose   OTPPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  usedAt    DateTime?
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, purpose])
  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([purpose])
}

model Profile {
  id                 String          @id @default(uuid())
  userId             String          @unique
  phone              String?
  university         String?
  cgpa               Float?
  city               String?
  state              String?
  country            String?
  bio                String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  resumeId           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  dateOfBirth        DateTime?
  course             String?
  currentSemester    String?
  educationLevel     EducationLevel?
  graduationYear     Int?
  institutionName    String?
  isProfileCompleted Boolean         @default(false)
  specialization     String?
  gender             Gender?
  careerGoals        CareerGoal[]
  interests          Interest[]
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             Skill[]
}

model Skill {
  id        String     @id @default(uuid())
  profileId String
  name      String
  level     SkillLevel
  createdAt DateTime   @default(now())
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Interest {
  id        String   @id @default(uuid())
  profileId String
  name      String
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model CareerGoal {
  id        String   @id @default(uuid())
  profileId String
  title     String
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, title])
}

model PasswordResetSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Opportunity {
  id                 String             @id @default(uuid())
  title              String
  description        String
  organization       String
  type               OpportunityType
  mode               OpportunityMode
  status             OpportunityStatus  @default(DRAFT)
  amount             String?
  location           String?
  registrationLink   String
  imageUrl           String?
  deadline           DateTime?
  startDate          DateTime?
  endDate            DateTime?
  educationLevel     EducationLevel?
  course             String?
  specialization     String?
  state              String?
  minCGPA            Float?
  featured           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  applicationProcess String?
  bannerUrl          String?
  benefits           String?
  city               String?
  eligibility        String?
  slug               String             @unique
  source             OpportunitySource
  verified           Boolean            @default(false)
  careerTags         String[]           @default([])
  interests          String[]           @default([])
  lastSyncedAt       DateTime?
  officialId         String?            @unique
  skills             String[]           @default([])
  sourceName         String?
  sourceUrl          String?
  applications       Application[]
  opportunityMatches OpportunityMatch[]
  roadmaps           Roadmap[]
  bookmarks          SavedOpportunity[]
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(SUBMITTED)
  appliedAt     DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id             String           @id @default(uuid())
  userId         String
  title          String
  type           DocumentType
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeAnalyses ResumeAnalysis[]

  @@index([userId])
}

model ResumeAnalysis {
  id            String   @id @default(cuid())
  documentId    String
  userId        String
  overallScore  Int
  atsScore      Int
  strengths     Json
  weaknesses    Json
  missingSkills Json
  improvements  Json
  summary       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  aiModel       String   @default("gemini-2.5-flash")
  version       Int      @default(1)
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([createdAt])
}

model Mission {
  id                     String          @id @default(cuid())
  userId                 String
  title                  String
  description            String
  estimatedMinutes       Int
  priority               MissionPriority @default(MEDIUM)
  status                 MissionStatus   @default(PENDING)
  createdAt              DateTime        @default(now())
  completedAt            DateTime?
  category               MissionCategory
  rewardOpportunityMatch Int?            @default(0)
  rewardProfileScore     Int?            @default(0)
  rewardResumeScore      Int?            @default(0)
  rewardXP               Int?            @default(0)
  updatedAt              DateTime        @updatedAt
  roadmapTaskId          String?         @unique
  roadmapTask            RoadmapTask?    @relation(fields: [roadmapTaskId], references: [id])
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([roadmapTaskId])
}

model UserXP {
  id                String   @id @default(cuid())
  userId            String   @unique
  totalXP           Int      @default(0)
  level             Int      @default(1)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  missionsCompleted Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id             String             @id @default(cuid())
  userId         String
  opportunityId  String?
  title          String
  description    String?
  readinessScore Int
  targetScore    Int
  estimatedDays  Int
  status         RoadmapStatus      @default(ACTIVE)
  aiSummary      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  generatedBy    String             @default("gemini-2.5-flash")
  progress       Int                @default(0)
  dailyHours     Float
  targetDate     DateTime?
  opportunity    Opportunity?       @relation(fields: [opportunityId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones     RoadmapMilestone[]

  @@index([userId])
}

model RoadmapMilestone {
  id          String          @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  order       Int
  status      MilestoneStatus @default(PENDING)
  roadmap     Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       RoadmapTask[]
}

model RoadmapTask {
  id               String           @id @default(cuid())
  milestoneId      String
  title            String
  description      String?
  estimatedMinutes Int
  status           TaskStatus       @default(PENDING)
  order            Int
  rewardXP         Int              @default(20)
  completedAt      DateTime?
  dayNumber        Int              @default(1)
  mission          Mission?
  milestone        RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model OpportunityMatch {
  id              String      @id @default(cuid())
  userId          String
  opportunityId   String
  matchScore      Int
  readinessScore  Int
  strengths       String[]
  missingSkills   String[]
  recommendations String[]
  summary         String
  generatedBy     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model OpportunitySync {
  id           String            @id @default(uuid())
  source       OpportunitySource
  sourceName   String
  status       String
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  fetchedCount Int               @default(0)
  createdCount Int               @default(0)
  updatedCount Int               @default(0)
  failedCount  Int               @default(0)
  error        String?
  createdAt    DateTime          @default(now())

  @@index([source, startedAt])
}

enum UserRole {
  STUDENT
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EducationLevel {
  SCHOOL
  INTERMEDIATE
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  CERTIFICATION
  OTHER
}

enum OpportunityType {
  SCHOLARSHIP
  HACKATHON
  INTERNSHIP
  JOB
  COURSE
  EVENT
  COMPETITION
  FELLOWSHIP
  COMPETITIVE_EXAM
  RESEARCH
  GRANT
  GOVERNMENT_SCHEME
}

enum OpportunityMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OpportunityStatus {
  OPEN
  UPCOMING
  CLOSED
  DRAFT
  EXPIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OpportunitySource {
  GOVERNMENT
  PRIVATE
  UNIVERSITY
  COMPANY
  NGO
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

enum DocumentType {
  RESUME
  AADHAAR
  PAN
  BONAFIDE
  INCOME_CERTIFICATE
  CASTE_CERTIFICATE
  MARKS_MEMO
  OTHER
}

enum MissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MissionPriority {
  LOW
  MEDIUM
  HIGH
}

enum MissionCategory {
  PROFILE
  RESUME
  SKILL
  APPLICATION
  CERTIFICATION
  PROJECT
  INTERVIEW
  HACKATHON
  OTHER
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model UserActivityDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}
