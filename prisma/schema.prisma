// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EducationLevel {
  SCHOOL
  INTERMEDIATE
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  CERTIFICATION
  COMPETITIVE_EXAM
  OTHER
}

enum OpportunityType {
  SCHOLARSHIP
  HACKATHON
  INTERNSHIP
  JOB
  COURSE
  EVENT
  COMPETITION
  FELLOWSHIP
}

enum OpportunityMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OpportunityStatus {
  DRAFT
  OPEN
  UPCOMING
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OpportunitySource {
  GOVERNMENT
  PRIVATE
  UNIVERSITY
  COMPANY
  NGO
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
}

enum DocumentType {
  RESUME
  AADHAAR
  PAN
  BONAFIDE
  INCOME_CERTIFICATE
  CASTE_CERTIFICATE
  MARKS_MEMO
  OTHER
}

enum MissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MissionPriority {
  LOW
  MEDIUM
  HIGH
}

enum MissionCategory {
  PROFILE
  RESUME
  SKILL
  APPLICATION
  CERTIFICATION
  PROJECT
  INTERVIEW
  HACKATHON
  OTHER
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id String @id @default(uuid())

  name          String
  email         String    @unique
  emailVerified DateTime?

  password String?
  image    String?
  profile  Profile?

  role                  UserRole               @default(STUDENT)
  isActive              Boolean                @default(true)
  lastLogin             DateTime?
  otpVerifications      OTPVerification[]
  passwordResetSessions PasswordResetSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  savedOpportunities SavedOpportunity[]
  applications       Application[]
  notifications      Notification[]
  documents          Document[]
  resumeAnalyses     ResumeAnalysis[]
  missions Mission[]
  roadmaps Roadmap[]
  xp UserXP?
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OTPVerification {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  email String

  otpHash String

  purpose OTPPurpose

  expiresAt DateTime

  attempts Int @default(0)

  createdAt DateTime @default(now())

  usedAt DateTime?

  @@unique([email, purpose])
  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([purpose])
}

model Profile {
  id String @id @default(uuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ==========================================
  // Personal Information
  // ==========================================

  phone String?

  gender Gender?

  dateOfBirth DateTime?

  city String?

  state String?

  country String?

  bio String?

  // ==========================================
  // Education
  // ==========================================

  educationLevel EducationLevel?

  institutionName String?

  university String?

  course String?

  specialization String?

  currentSemester String?

  graduationYear Int?

  cgpa Float?

  // ==========================================
  // Professional Profiles
  // ==========================================

  linkedinUrl String?

  githubUrl String?

  portfolioUrl String?

  resumeId String?

  // ==========================================
  // Profile Status
  // ==========================================

  isProfileCompleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================
  // Relations
  // ==========================================

  skills Skill[]

  interests Interest[]

  careerGoals CareerGoal[]
}

model Skill {
  id String @id @default(uuid())

  profileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name String

  level SkillLevel

  createdAt DateTime @default(now())

  @@unique([profileId, name])
}

model Interest {
  id String @id @default(uuid())

  profileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())

  @@unique([profileId, name])
}

model CareerGoal {
  id String @id @default(uuid())

  profileId String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title String

  createdAt DateTime @default(now())

  @@unique([profileId, title])
}

model PasswordResetSession {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
}

model Opportunity {
  id String @id @default(uuid())

  title String

  slug String @unique

  description String @db.Text

  organization String

  source OpportunitySource

  type OpportunityType

  mode OpportunityMode

  status OpportunityStatus @default(DRAFT)

  location String?

  registrationLink String

  officialId String?

  imageUrl String?

  bannerUrl String?

  lastSyncedAt DateTime?

  amount String?

  eligibility String? @db.Text

  benefits String? @db.Text

  applicationProcess String? @db.Text

  deadline DateTime?

  startDate DateTime?

  endDate DateTime?

  educationLevel EducationLevel?

  course String?

  specialization String?

  state String?

  city String?

  minCGPA Float?

  featured Boolean @default(false)

  verified Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  bookmarks    SavedOpportunity[]
  applications Application[]

  skills String[] @default([])

  interests String[] @default([])

  careerTags String[] @default([])
  roadmaps Roadmap[]
}

model SavedOpportunity {
  id String @id @default(uuid())

  userId String

  opportunityId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

model Application {
  id String @id @default(uuid())

  userId String

  opportunityId String

  status ApplicationStatus @default(SUBMITTED)

  appliedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

model Notification {
  id String @id @default(uuid())

  userId String

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id String @id @default(uuid())

  userId String

  title String

  type DocumentType

  fileUrl String

  fileName String

  fileSize Int

  mimeType String

  verified Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  resumeAnalyses ResumeAnalysis[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ResumeAnalysis {
  id String @id @default(cuid())

  documentId String

  userId String

  overallScore Int

  atsScore Int

  strengths Json

  weaknesses Json

  missingSkills Json

  improvements Json

  summary String @db.Text

  aiModel String @default("gemini-2.5-flash")

  version Int @default(1)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([createdAt])
}


model Mission {

  id String @id @default(cuid())

  userId String

  title String

  description String

  category MissionCategory

  priority MissionPriority @default(MEDIUM)

  status MissionStatus @default(PENDING)

  estimatedMinutes Int

  // Structured rewards
  rewardResumeScore Int? @default(0)

  rewardOpportunityMatch Int? @default(0)

  rewardProfileScore Int? @default(0)

  rewardXP Int? @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  completedAt DateTime?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])

  @@index([status])

  @@index([category])
}

model UserXP {

  id String @id @default(cuid())

  userId String @unique

  totalXP Int @default(0)

  level Int @default(1)

  currentStreak Int @default(0)

  longestStreak Int @default(0)

  missionsCompleted Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

}

model Roadmap {

  id String @id @default(cuid())

  userId String

  opportunityId String?

  title String

  description String?

  readinessScore Int

  targetScore Int

  estimatedDays Int

  status RoadmapStatus @default(ACTIVE)

  aiSummary String? @db.Text

  generatedBy String @default("gemini-2.5-flash")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields:[userId],references:[id],onDelete:Cascade)

  opportunity Opportunity? @relation(fields:[opportunityId], references:[id])

  milestones RoadmapMilestone[]

  @@index([userId])
}

model RoadmapMilestone {

  id String @id @default(cuid())

  roadmapId String

  title String

  description String?

  order Int

  roadmap Roadmap @relation(fields:[roadmapId],references:[id],onDelete:Cascade)

  tasks RoadmapTask[]
}

model RoadmapTask {

  id String @id @default(cuid())

  milestoneId String

  title String

  description String?

  estimatedMinutes Int

  status TaskStatus @default(PENDING)

  order Int

  rewardXP Int @default(20)

  milestone RoadmapMilestone @relation(fields:[milestoneId],references:[id],onDelete:Cascade)
}